# =============================================
# SecureMail — .gitignore
# =============================================

# Environment variables — NEVER commit these
.env
.env.local
.env.production
.env.staging
.env.*

# OAuth credentials
credentials/
credentials.json
token.json
client_secret*.json

# =============================================
# Database
# =============================================
db.sqlite3
db.sqlite3-journal
*.db

# =============================================
# Python
# =============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =============================================
# Testing & Coverage
# =============================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# =============================================
# Django
# =============================================
staticfiles/
media/
logs/
*.log

# =============================================
# ML Datasets (never commit training data)
# =============================================
SecureMail/ml/datasets/

# =============================================
# Node (if used for frontend tooling)
# =============================================
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# =============================================
# IDE / Editor
# =============================================
.idea/
.vscode/
*.swp
*.swo
*.swn
.project
.settings/
*.sublime-project
*.sublime-workspace

# =============================================
# OS artifacts
# =============================================
.DS_Store
.DS_Store?
Thumbs.db
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# =============================================
# Project-specific
# =============================================
audit_notes.txt
*.csv
email/
Result.txt
